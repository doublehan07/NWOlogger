{
 "id": "CQWW-RTTY",
 "name": "CQ WW RTTY DX Contest",
 "cabrillo": "CQ-WW-RTTY",
 "sponsor": "CQ",
 "notes": "Scoring follows the sponsor's published rules as of 2026. Claimed score only: check the current rules before you submit.",
 "modes": [
  "DATA"
 ],
 "default_mode": "RTTY",
 "bands": [
  "80m",
  "40m",
  "20m",
  "15m",
  "10m"
 ],
 "dupe": "band",
 "exchange": [
  {
   "key": "rst",
   "label": "RST",
   "kind": "rst"
  },
  {
   "key": "zone",
   "label": "CQ zone",
   "kind": "int",
   "min": 1,
   "max": 40,
   "prefill": "cqz",
   "sent_from": "my_cq_zone",
   "adif": "cqz"
  },
  {
   "key": "qth",
   "label": "State/Prov",
   "kind": "text",
   "optional": true,
   "only_if": [
    "they_dxcc_in:291,1"
   ],
   "adif": "state",
   "sent_from": "my_state"
  }
 ],
 "points": [
  {
   "when": [
    "same_dxcc"
   ],
   "points": 1
  },
  {
   "when": [
    "same_cont"
   ],
   "points": 2
  },
  {
   "points": 3
  }
 ],
 "mults": [
  {
   "key": "zone",
   "label": "Zones",
   "value": "exch:zone",
   "per": "band"
  },
  {
   "key": "dxcc",
   "label": "Countries",
   "value": "dxcc",
   "per": "band"
  },
  {
   "key": "qth",
   "label": "W/VE QTHs",
   "value": "exch:qth",
   "per": "band",
   "when": [
    "they_dxcc_in:291,1"
   ]
  }
 ]
}
